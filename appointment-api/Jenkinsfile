pipeline {
  agent any

  environment {
    BUILD_ID = "${env.BUILD_NUMBER}"
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Docker Login') {
      steps {
        script {
          try {
            withCredentials([
              usernamePassword(
                credentialsId: 'dockerhub-jenkins',
                usernameVariable: 'DOCKER_USER',
                passwordVariable: 'DOCKER_PASS'
              )
            ]) {
              sh '''
                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
              '''
            }
          } catch (err) {
            echo "WARNING: Docker login failed. Some stages may not work: ${err}"
          }
        }
      }
    }

    stage('Build & Push Frontend') {
      steps {
        sh '''
          docker build -t pranathi0906/frontend-api:${BUILD_ID} -t pranathi0906/frontend-api:latest hospital-frontend
          docker push pranathi0906/frontend-api:${BUILD_ID}
          docker push pranathi0906/frontend-api:latest
        '''
      }
    }

    stage('Build & Push Patient API') {
      steps {
        sh '''
          docker build -t pranathi0906/patient-api:${BUILD_ID} -t pranathi0906/patient-api:latest patient-api
          docker push pranathi0906/patient-api:${BUILD_ID}
          docker push pranathi0906/patient-api:latest
        '''
      }
    }

    stage('Build & Push Appointment API') {
      steps {
        sh '''
          docker build -t pranathi0906/appointment-api:${BUILD_ID} -t pranathi0906/appointment-api:latest appointment-api
          docker push pranathi0906/appointment-api:${BUILD_ID}
          docker push pranathi0906/appointment-api:latest
        '''
      }
    }

    stage('Create Namespace & Deploy MySQL') {
      steps {
        sh '''
          kubectl create namespace hospital --dry-run=client -o yaml | kubectl apply -f -

          kubectl apply -n hospital -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mysql
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mysql
  template:
    metadata:
      labels:
        app: mysql
    spec:
      containers:
      - name: mysql
        image: mysql:8.0
        env:
        - name: MYSQL_ROOT_PASSWORD
          value: pass123
        - name: MYSQL_DATABASE
          value: hospital
        - name: MYSQL_USER
          value: user
        - name: MYSQL_PASSWORD
          value: pass123
        ports:
        - containerPort: 3306
---
apiVersion: v1
kind: Service
metadata:
  name: mysql
spec:
  selector:
    app: mysql
  ports:
  - port: 3306
    targetPort: 3306
EOF
        '''
      }
    }

    stage('Deploy Frontend') {
      steps {
        sh '''
          helm upgrade --install frontend-api ./hpm \
            --namespace hospital \
            -f hpm/values-front.yaml \
            --set image.tag=${BUILD_ID} \
            --set imagePullSecrets[0].name=dockerhub-secret
        '''
      }
    }

    stage('Deploy Patient API') {
      steps {
        sh '''
          helm upgrade --install patient-api ./hpm \
            --namespace hospital \
            -f hpm/values-patient.yaml \
            --set image.tag=${BUILD_ID} \
            --set imagePullSecrets[0].name=dockerhub-secret
        '''
      }
    }

    stage('Deploy Appointment API') {
      steps {
        sh '''
          helm upgrade --install appointment-api ./hpm \
            --namespace hospital \
            -f hpm/values-appoint.yaml \
            --set image.tag=${BUILD_ID} \
            --set imagePullSecrets[0].name=dockerhub-secret
        '''
      }
    }

  } // closes stages
} // closes pipeline

